{
  "name": "math110-site",
  "version": "1.0.0",
  "private": true,
  "description": "MATH 110 course website — Instituto College",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && node serve.mjs",
    "publish-site": "node build.mjs && node publish.mjs && node notify.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File send-mail.ps1",
    "publish-quiet": "node build.mjs && node publish.mjs && node notify.mjs",
    "setup-mail": "powershell -NoProfile -ExecutionPolicy Bypass -File setup-mail.ps1",
    "test-mail": "powershell -NoProfile -ExecutionPolicy Bypass -File send-mail.ps1 -TestOnly",
    "preview-mail": "powershell -NoProfile -ExecutionPolicy Bypass -File send-mail.ps1 -DryRun"
  }
}
